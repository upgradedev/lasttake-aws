{
  "name": "lasttake-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/copy-testbook.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
